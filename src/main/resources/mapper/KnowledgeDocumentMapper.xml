<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ticket.system.mapper.KnowledgeDocumentMapper">

    <resultMap id="BaseResultMap" type="com.ticket.system.entity.KnowledgeDocument">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="title" property="title" jdbcType="VARCHAR"/>
        <result column="filename" property="filename" jdbcType="VARCHAR"/>
        <result column="category" property="category" jdbcType="VARCHAR"/>
        <result column="content" property="content" jdbcType="LONGVARCHAR"/>
        <result column="file_path" property="filePath" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.ticket.system.entity.KnowledgeDocument" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO knowledge_document (title, filename, category, content, file_path, status, created_at, updated_at)
        VALUES (#{title}, #{filename}, #{category}, #{content}, #{filePath}, #{status}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.ticket.system.entity.KnowledgeDocument">
        UPDATE knowledge_document
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="filename != null">filename = #{filename},</if>
            <if test="category != null">category = #{category},</if>
            <if test="content != null">content = #{content},</if>
            <if test="filePath != null">file_path = #{filePath},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM knowledge_document WHERE id = #{id}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM knowledge_document WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM knowledge_document ORDER BY created_at DESC
    </select>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT * FROM knowledge_document WHERE status = #{status} ORDER BY created_at DESC
    </select>

    <select id="selectByCategory" resultMap="BaseResultMap">
        SELECT * FROM knowledge_document WHERE category = #{category} ORDER BY created_at DESC
    </select>
</mapper>
